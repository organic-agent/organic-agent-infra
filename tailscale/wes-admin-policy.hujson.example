// 기존 tailnet policy의 같은 최상위 키에 병합한다.
// group:wes-super-admins에는 실제 최고 관리자 계정만 둔다.
{
  "groups": {
    "group:wes-super-admins": [
      "eatyasic@gmail.com",
    ],
  },

  "tagOwners": {
    // tailnet 운영 계정이 백오피스 서버용 auth key와 tag를 관리한다.
    "tag:wes-admin": ["asmorganicagent@gmail.com"],
  },

  "grants": [
    {
      "src": ["group:wes-super-admins"],
      "dst": ["tag:wes-admin"],
      "ip": ["tcp:443"],
    },
  ],

  "tests": [
    {
      "src": "eatyasic@gmail.com",
      "proto": "tcp",
      "accept": ["tag:wes-admin:443"],
      "deny": [
        "tag:wes-admin:22",
        "tag:wes-admin:8080",
        "tag:wes-admin:8443",
      ],
    },
    {
      "src": "asmorganicagent@gmail.com",
      "proto": "tcp",
      "deny": ["tag:wes-admin:443"],
    },
  ],
}
