#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl docker.io docker-compose-v2 iptables util-linux

# Tailscale 공식 stable 저장소(ubuntu noble).
curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg \
  -o /usr/share/keyrings/tailscale-archive-keyring.gpg
curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.tailscale-keyring.list \
  -o /etc/apt/sources.list.d/tailscale.list
apt-get update
apt-get install -y tailscale

# Ubuntu 24.04 AMI에는 AWS CLI가 기본 포함되지 않는다. SSM SecureString을 부팅 시에만 읽는다.
snap install aws-cli --classic

systemctl enable --now docker tailscaled
if snap list amazon-ssm-agent >/dev/null 2>&1; then
  snap start amazon-ssm-agent
else
  systemctl enable --now amazon-ssm-agent
fi

# BackOffice는 외부 라우팅 없는 internal network에만 붙이고, 관리자 API만 별도 runtime
# network를 함께 써서 IMDS/RDS/AWS API에 접근한다. 같은 스크립트는 SSM Association으로도
# 실행되어 기존 인스턴스와 재부팅 후 방화벽 상태를 맞춘다.
printf '%s' '${runtime_host_script_base64}' | base64 -d > /usr/local/sbin/configure-wes-admin-runtime
chmod 0755 /usr/local/sbin/configure-wes-admin-runtime
/usr/local/sbin/configure-wes-admin-runtime

# Route53 DNS provider를 포함한 Caddy를 버전 고정 빌드하고 호스트 systemd로 실행한다.
# Caddy는 호스트에서 실행되어 container metadata 경계와 무관하다. hop limit 2는 별도
# runtime network의 관리자 API에만 필요하고 BackOffice는 위 방화벽으로 차단된다.
builder_name="wes-admin-caddy-builder"
docker rm -f "$builder_name" >/dev/null 2>&1 || true
docker run --name "$builder_name" --entrypoint /bin/sh \
  "caddy:${caddy_version}-builder-alpine" -c \
  "xcaddy build v${caddy_version} --with github.com/caddy-dns/route53@${caddy_route53_version} --output /tmp/caddy"
docker cp "$builder_name:/tmp/caddy" /usr/local/bin/caddy
docker rm "$builder_name"
chmod 0755 /usr/local/bin/caddy
/usr/local/bin/caddy list-modules | grep -qx 'dns.providers.route53'

id -u caddy >/dev/null 2>&1 || useradd --system --home-dir /var/lib/caddy --shell /usr/sbin/nologin caddy
install -d -m 0755 /etc/caddy
printf '%s' '${caddyfile_base64}' | base64 -d > /etc/caddy/Caddyfile
printf '%s' '${caddy_service_base64}' | base64 -d > /etc/systemd/system/caddy.service
chmod 0644 /etc/caddy/Caddyfile /etc/systemd/system/caddy.service
/usr/local/bin/caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

# 키 값은 Terraform/user_data/state에 들어가지 않는다. tag:wes-admin이 사전 지정된
# 일회용·pre-approved auth key를 SSM SecureString에서 읽고 현재 프로세스에서만 사용한다.
TS_AUTH_KEY="$(/snap/bin/aws ssm get-parameter \
  --region '${aws_region}' \
  --name '${tailscale_auth_parameter_name}' \
  --with-decryption \
  --query Parameter.Value \
  --output text)"
if [ -z "$TS_AUTH_KEY" ] || [ "$TS_AUTH_KEY" = "None" ]; then
  echo "Tailscale auth key parameter is empty" >&2
  exit 1
fi

tailscale up \
  --auth-key="$TS_AUTH_KEY" \
  --hostname='${tailscale_hostname}' \
  --advertise-tags=tag:wes-admin \
  --accept-dns=false \
  --accept-routes=false
unset TS_AUTH_KEY

systemctl daemon-reload
systemctl enable --now caddy
sha256sum /etc/caddy/Caddyfile | awk '{print $1}' > /var/lib/caddy/wes-config.sha256
chmod 0644 /var/lib/caddy/wes-config.sha256

# TLS는 Caddy가 localhost:${proxy_https_port}에서 종료한다. Serve는 인증서를 발급하지 않고
# tailnet의 443/TCP만 raw TCP로 전달한다. Funnel은 구성하지 않는다.
tailscale serve --bg --tcp=443 tcp://127.0.0.1:${proxy_https_port}
