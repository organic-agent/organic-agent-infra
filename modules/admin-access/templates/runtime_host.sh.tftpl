#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

for attempt in $(seq 1 60); do
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    break
  fi
  if [ "$attempt" -eq 60 ]; then
    echo "Docker did not become ready within 300 seconds" >&2
    exit 1
  fi
  sleep 5
done

# user_data 변경은 Tailscale identity 보존을 위해 기존 인스턴스에 반영하지 않는다.
# 따라서 SSM Association으로도 Compose v2를 보정해 서버 CD의 실행 계약을 맞춘다.
if ! docker compose version >/dev/null 2>&1; then
  apt-get -o DPkg::Lock::Timeout=600 update
  apt-get -o DPkg::Lock::Timeout=600 install -y docker-compose-v2
fi
docker compose version >/dev/null

touch '${deploy_lock_path}'
chmod 0600 '${deploy_lock_path}'
exec 9>'${deploy_lock_path}'
flock -w 600 9 || {
  echo "Another wes-admin deployment is in progress" >&2
  exit 1
}

ensure_network() {
  name="$1"
  subnet="$2"
  internal="$3"

  if docker network inspect "$name" >/dev/null 2>&1; then
    actual_subnet=$(docker network inspect --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}' "$name")
    actual_internal=$(docker network inspect --format '{{.Internal}}' "$name")
    if [ "$actual_subnet" != "$subnet" ] || [ "$actual_internal" != "$internal" ]; then
      echo "Docker network $name exists with unexpected settings: subnet=$actual_subnet internal=$actual_internal" >&2
      exit 1
    fi
    return
  fi

  if [ "$internal" = "true" ]; then
    docker network create --driver bridge --internal --subnet "$subnet" "$name"
  else
    docker network create --driver bridge --subnet "$subnet" "$name"
  fi
}

ensure_network '${internal_network_name}' '${internal_network_subnet}' true
ensure_network '${runtime_network_name}' '${runtime_network_subnet}' false

# 기존 인스턴스는 user_data 변경을 무시하므로 Caddy upstream 변경도 Association에서
# 원자적으로 반영한다. 새 설정을 먼저 검증하고 적용 상태가 다를 때만 restart한다.
caddyfile_tmp=$(mktemp)
printf '%s' '${caddyfile_base64}' | base64 -d > "$caddyfile_tmp"
# 신규 인스턴스의 첫 user_data 실행에서는 이 스크립트 뒤에 Caddy를 설치한다. 기존
# 인스턴스/Association 경로에서만 여기서 검증·restart하고, bootstrap은 후단 설치가 맡는다.
if [ -x /usr/local/bin/caddy ] && [ -f /etc/systemd/system/caddy.service ]; then
  /usr/local/bin/caddy validate --config "$caddyfile_tmp" --adapter caddyfile
  caddy_state_file=/var/lib/caddy/wes-config.sha256
  desired_caddy_sha=$(sha256sum "$caddyfile_tmp" | awk '{print $1}')
  applied_caddy_sha=$(cat "$caddy_state_file" 2>/dev/null || true)
  if [ "$desired_caddy_sha" != "$applied_caddy_sha" ] || \
    ! cmp -s "$caddyfile_tmp" /etc/caddy/Caddyfile || \
    ! systemctl is-active --quiet caddy.service; then
    caddyfile_backup=$(mktemp)
    cp /etc/caddy/Caddyfile "$caddyfile_backup"
    install -m 0644 "$caddyfile_tmp" /etc/caddy/Caddyfile
    if systemctl restart caddy.service; then
      printf '%s\n' "$desired_caddy_sha" > "$caddy_state_file"
      chmod 0644 "$caddy_state_file"
    else
      install -m 0644 "$caddyfile_backup" /etc/caddy/Caddyfile
      if systemctl restart caddy.service; then
        echo "Caddy restart failed; previous configuration restored and restarted" >&2
      else
        echo "Caddy restart failed; previous configuration restored but service recovery failed" >&2
      fi
      rm -f "$caddyfile_backup" "$caddyfile_tmp"
      exit 1
    fi
    rm -f "$caddyfile_backup"
  fi
fi
rm -f "$caddyfile_tmp"

cat > /usr/local/sbin/wes-admin-metadata-firewall <<'FIREWALL'
#!/bin/bash
set -euo pipefail

rule=(-s '${internal_network_subnet}' -d 169.254.169.254/32 -j REJECT --reject-with icmp-port-unreachable)
iptables -C DOCKER-USER "$${rule[@]}" >/dev/null 2>&1 || iptables -I DOCKER-USER 1 "$${rule[@]}"
FIREWALL
chmod 0755 /usr/local/sbin/wes-admin-metadata-firewall

cat > /etc/systemd/system/wes-admin-metadata-firewall.service <<'UNIT'
[Unit]
Description=Block BackOffice Docker network from EC2 instance metadata
After=docker.service
Requires=docker.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/wes-admin-metadata-firewall
RemainAfterExit=yes

[Install]
WantedBy=docker.service
UNIT

systemctl daemon-reload
systemctl enable wes-admin-metadata-firewall.service
systemctl restart wes-admin-metadata-firewall.service
